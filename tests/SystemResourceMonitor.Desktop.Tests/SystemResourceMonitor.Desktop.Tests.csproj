<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Per-monitor DPI awareness, so work-area and window rectangles are read in physical pixels. -->
    <ApplicationManifest>..\..\src\system-resources\SystemResourceMonitor.Desktop\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Referenced so both executables are copied to the test output and launched as separate processes;
       the test host also supplies the desktop probe. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\system-resources\SystemResourceMonitor.Desktop\SystemResourceMonitor.Desktop.csproj" />
    <ProjectReference Include="..\SystemResourceMonitor.Desktop.TestHost\SystemResourceMonitor.Desktop.TestHost.csproj" />
  </ItemGroup>

</Project>
